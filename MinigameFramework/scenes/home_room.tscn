[node name="MinigameInteractable" type="Area2D" parent="Ninja" unique_id=1939424318]
script = ExtResource("20_ijakw")
interaction_text = Array[String](["That monster! He has some technique, some forbidden jutsu.", "You! You might be the one who'll take him down!", "Mikey Tysen, \"The Monster\"", "I can tell you fight, just by the way you move. You might be a match for him!", "Keep an eye out for his signature move, the \"project every punch\".", "I've been fighting him for decades, but I still can't figure out how to beat it!", "But you, you might be able to do it!", "I know you've been training your whole life for this opportunity. You've got this!"])
minigame_group = ExtResource("44_3dfs3")
metadata/_custom_type_script = "uid://dh23numijpv1d"

[node name="CollisionShape2D" type="CollisionShape2D" parent="Ninja/MinigameInteractable" unique_id=353218759]
shape = SubResource("RectangleShape2D_mohvt")

