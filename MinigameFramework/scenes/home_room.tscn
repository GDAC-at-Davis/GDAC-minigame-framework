[node name="MinigameInteractable" type="Area2D" parent="Avalanche" unique_id=1144489678]
script = ExtResource("20_ijakw")
interaction_text = Array[String](["Brrr~ Hey! You know how to ski, right?", "I live way up top of Mount Everest, but it's a treacherous journey!", "Things keep hitting me, and then I tumble all the way back down.", "Can you help me call the shots?", "Just tell me where to go, and help me get past these darn icicles!"])
