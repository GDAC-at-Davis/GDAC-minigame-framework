[node name="MinigameInteractable" type="Area2D" parent="Pitch" unique_id=894197094]
script = ExtResource("20_ijakw")
interaction_text = Array[String](["Yes! It is me, famous soccer player Ronaldo Messi!", "I'm kidding of course, I'm just Chistrian Lion.", "I need to cinch my next foul kick, but I'm...", "Very drunk.", "Ah, but you're a great coach, I'm sure. Right?", "I'll just wind up my leg and, when you say go, I'll go!", "It's only the World Cup, no pressure!"])
