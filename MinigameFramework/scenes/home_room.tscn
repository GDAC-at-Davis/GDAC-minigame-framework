[node name="MinigameInteractable" type="Area2D" parent="Browser" unique_id=1684639081]
script = ExtResource("20_ijakw")
interaction_text = Array[String](["AAAAAAAAAA!", "The cops-I mean, my parents are gonna kill me!", "I left all my browser tabs open!", "You'll help me right? I don't have the APM to do it before \"they\" get here- uh, home!", "Help me close all the weird tabs, okay?", "You've got it, k thx bye bye!"])
