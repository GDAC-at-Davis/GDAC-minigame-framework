[node name="MinigameInteractable" type="Area2D" parent="Bloon" unique_id=513514268]
script = ExtResource("20_ijakw")
interaction_text = Array[String](["Oh, a valiant hero! Thank goodness you're here!", "I've been trapped here for a thousand years... slowly deflating...", "Fulfill my last wishes, please!", "My brother must be avenged... kill the Stringies!", "Use those mighty limbs of yours and pop as many as you can!"])
minigame_group = ExtResource("21_ijakw")
