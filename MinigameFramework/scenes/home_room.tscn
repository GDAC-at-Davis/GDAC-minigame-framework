[node name="MinigameInteractable" type="Area2D" parent="Homerun" unique_id=340953591]
script = ExtResource("20_ijakw")
interaction_text = Array[String](["Woah woah! Back up! I almost hit you!", "I'm trying to warm up my hitting arm! The game-winning hit is on me!", "Wait a second... Let me take a look at you...", "Those well defined arms, that menacing focus in your eye...", "You've got to hit for me! Here, I have a spare set of clothes...", "Alright, it's a deal right? You'll hit a homerun for me, and I'll", "I'll do something for you, eventually.", "You can trust me, or my name's not Showhay Ohtawni!", "You've got this champ!"])
